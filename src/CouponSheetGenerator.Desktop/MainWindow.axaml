<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CouponSheetGenerator.Desktop"
    x:Class="CouponSheetGenerator.Desktop.MainWindow"
    x:DataType="local:MainViewModel"
    Title="Coupon Sheet Generator"
    Width="1120"
    Height="760"
    MinWidth="780"
    MinHeight="560">
    <Grid RowDefinitions="Auto,*,Auto" Margin="22">
        <StackPanel Spacing="4">
            <TextBlock Text="Coupon Sheet Generator" FontSize="27" FontWeight="Bold" />
            <TextBlock Text="Import TSV  →  Review validation  →  Customize  →  Preview  →  Export PDF" Opacity="0.7" />
        </StackPanel>
        <TabControl Grid.Row="1" Margin="0,20,0,12">
            <TabItem Header="Import &amp; records">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,*" RowSpacing="12" Margin="12">
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Choose TSV" Command="{Binding ImportCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/><TextBlock Text="{Binding InputPath}" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"><TextBlock Text="Filter products" VerticalAlignment="Center"/><TextBox Width="250" Text="{Binding RecordFilter}" PlaceholderText="Type to filter records"/></StackPanel>
                    <DataGrid Grid.Row="4" ItemsSource="{Binding VisibleRecords}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" HeadersVisibility="Column" >
                        <DataGrid.Columns><DataGridTextColumn Header="Source row" Binding="{Binding Row}"/><DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Eligibility" Binding="{Binding Status}"/></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="5" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="260" Text="{Binding IssueFilter}" PlaceholderText="Search validation issues"/><Button Content="Copy diagnostic details" Click="CopyDiagnostics"/></StackPanel><ListBox ItemsSource="{Binding VisibleIssues}" Height="180"/></StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Coupon design">
                <ScrollViewer><StackPanel Margin="12" Spacing="12" MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="Document content" FontSize="18" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Minimal preset" Command="{Binding MinimalPresetCommand}"/><Button Content="Modern preset" Command="{Binding ModernPresetCommand}"/><Button Content="Ink-saving preset" Command="{Binding InkSavingPresetCommand}"/></StackPanel>
                    <TextBlock Text="Title"/><TextBox Text="{Binding Title}" PlaceholderText="Optional title"/>
                    <TextBlock Text="Footer"/><TextBox Text="{Binding Footer}" PlaceholderText="Optional footer"/>
                    <TextBlock Text="Accent color (#RRGGBB)"/><TextBox Text="{Binding AccentColor}" PlaceholderText="e.g., #FF5733"/>
                    <TextBlock Text="Background color (#RRGGBB)"/><TextBox Text="{Binding BackgroundColor}" PlaceholderText="e.g., #F0F0F0"/>
                    <CheckBox Content="Show Given to" IsChecked="{Binding IncludeGivenTo}"/>
                    <CheckBox Content="Show internal IDs" IsChecked="{Binding IncludeIds}"/>
                    <CheckBox Content="Show product name" IsChecked="{Binding ShowProductName}"/>
                    <CheckBox Content="Show dates" IsChecked="{Binding ShowDates}"/>
                    <CheckBox Content="Show status labels" IsChecked="{Binding ShowStatus}"/>
                    <CheckBox Content="Show order name" IsChecked="{Binding ShowOrderName}"/>
                    <TextBlock Text="Instruction text"/><TextBox Text="{Binding InstructionText}"/>
                    <TextBlock Text="Promotional code font size (0 = automatic)"/><NumericUpDown Value="{Binding CodeFontSize}" Minimum="0" Maximum="30"/>
                    <TextBlock Text="QR size (mm)"/><NumericUpDown Value="{Binding QrSizeMm}" Minimum="20" Maximum="60"/>
                    <TextBlock Text="Card padding (mm)"/><NumericUpDown Value="{Binding CardPaddingMm}" Minimum="0" Maximum="20"/>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Choose PNG/JPEG logo…" Command="{Binding ChooseLogoCommand}"/><TextBlock Text="{Binding Logo}" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock Text="URL text: none, short, or full"/><TextBox Text="{Binding IncludeUrl}"/>
                    <CheckBox Content="Black and white" IsChecked="{Binding BlackAndWhite}"/>
                    <TextBlock Text="{Binding SettingsError}" Foreground="Crimson" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Page &amp; print layout">
                <ScrollViewer><StackPanel Margin="12" Spacing="12" MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="Page layout" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Page size: A4 or Letter"/><TextBox Text="{Binding PageSize}"/>
                    <TextBlock Text="Orientation: portrait or landscape"/><TextBox Text="{Binding Orientation}"/>
                    <TextBlock Text="Columns"/><NumericUpDown Value="{Binding Columns}" Minimum="1" Maximum="10"/>
                    <TextBlock Text="Rows"/><NumericUpDown Value="{Binding Rows}" Minimum="1" Maximum="10"/>
                    <TextBlock Text="Margin (mm)"/><NumericUpDown Value="{Binding Margin}" Minimum="0" Maximum="100"/>
                    <TextBlock Text="Card gap (mm)"/><NumericUpDown Value="{Binding CardGap}" Minimum="0" Maximum="100"/>
                    <CheckBox Content="Cut marks" IsChecked="{Binding CutMarks}"/>
                    <CheckBox Content="Page numbers" IsChecked="{Binding PageNumbers}"/>
                    <TextBlock Text="Eligibility filters" FontSize="18" FontWeight="Bold"/>
                    <CheckBox Content="Include redeemed" IsChecked="{Binding IncludeRedeemed}"/>
                    <CheckBox Content="Include unavailable" IsChecked="{Binding IncludeUnavailable}"/>
                    <CheckBox Content="Include expired" IsChecked="{Binding IncludeExpired}"/>
                    <CheckBox Content="Include future-starting" IsChecked="{Binding IncludeFuture}"/>
                    <TextBlock Text="{Binding LayoutSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SettingsError}" Foreground="Crimson" TextWrapping="Wrap"/>
                    <TextBlock Text="Print at Actual size / 100%."/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Preview &amp; export">
                <StackPanel Margin="12" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh preview PDF" Command="{Binding PreviewCommand}"/><Button Content="Export PDF…" Command="{Binding ExportCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Previous" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center"/><Button Content="Next" Command="{Binding NextPageCommand}"/><Button Content="Zoom −" Command="{Binding ZoomOutCommand}"/><TextBlock Text="{Binding ZoomLabel}" VerticalAlignment="Center"/><Button Content="Zoom +" Command="{Binding ZoomInCommand}"/><Button Content="Fit page" Command="{Binding FitPageCommand}"/><Button Content="Open preview window" Click="OpenPreviewWindow"/></StackPanel>
                    <TextBlock Text="{Binding PreviewStatus}" TextWrapping="Wrap"/>
                    <ScrollViewer Height="450"><Image Source="{Binding PreviewImage}" Width="{Binding PreviewWidth}" Stretch="Uniform" HorizontalAlignment="Left"/></ScrollViewer>
                </StackPanel>
            </TabItem>
            <TabItem Header="Settings &amp; About">
                <StackPanel Margin="12" Spacing="12">
                    <TextBlock Text="Shared configuration" FontSize="18" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Import JSON…" Command="{Binding LoadSettingsCommand}"/><Button Content="Save JSON As…" Command="{Binding SaveSettingsCommand}"/><Button Content="Reset document settings" Command="{Binding ResetSettingsCommand}"/></StackPanel>
                    <TextBlock Text="Desktop only — does not change the exported PDF." FontWeight="SemiBold"/>
                    <TextBlock Text="Theme"/><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Width="180" HorizontalAlignment="Left"/>
                    <Button Content="Reset desktop preferences" Command="{Binding ResetDesktopPreferencesCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="Version"/><TextBlock Text="{Binding Version}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
